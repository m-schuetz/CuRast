{
	// Debug configurations for CuRast. Each one builds first (see tasks.json).
	// - "cppdbg" requires the C/C++ extension (ms-vscode.cpptools)
	// - "cuda-gdb" requires NVIDIA Nsight Visual Studio Code Edition (nvidia.nsight-vscode-edition)
	// The working directory is the workspace folder, like the "Run App" task, so captures end up in ./td.
	"version": "0.2.0",
	"configurations": [
		{
			// Optimized build in ./build. No debug info, but gdb still shows function names in backtraces of crashes.
			"name": "CuRast (Release)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/CuRast",
			"args": [],
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/usr/bin/gdb",
			"setupCommands": [
				{"description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true}
			],
			"preLaunchTask": "Build (Release)"
		},
		{
			// Unoptimized host code with debug info in ./build-debug. Kernels keep their optimizations.
			"name": "CuRast (Debug)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build-debug/CuRast",
			"args": [],
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/usr/bin/gdb",
			"setupCommands": [
				{"description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true}
			],
			"preLaunchTask": "Build (Debug)"
		},
		{
			// Debug build under cuda-gdb: stops at CUDA API errors and in kernels that crash, e.g. on illegal memory accesses.
			// Kernels are compiled with -lineinfo, which maps them to source lines. Stepping through kernels additionally
			// requires compiling them with -G, e.g. by configuring build-debug with -DCMAKE_CUDA_FLAGS=-G (slow kernels).
			"name": "CuRast (cuda-gdb, Debug)",
			"type": "cuda-gdb",
			"request": "launch",
			"program": "${workspaceFolder}/build-debug/CuRast",
			"args": "",
			"cwd": "${workspaceFolder}",
			"debuggerPath": "/usr/local/cuda/bin/cuda-gdb",
			"breakOnLaunch": false,
			"onAPIError": "stop",
			"preLaunchTask": "Build (Debug)"
		}
	]
}
